{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedVariables": "warn",
				"noConstAssign": "error",
				"noConstantCondition": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noDoubleEquals": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 160
	},
	"files": {
		"maxSize": 5242880,
		"includes": [
			"editor/**/*.ts",
			"synth/**/*.ts",
			"player/**/*.ts",
			"shared/**/*.ts",
			"!build/**",
			"!website/**",
			"!archive/**",
			"!conventions/**",
			"!.kilocode/**"
		]
	}
}
