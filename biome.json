{
	"$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedVariables": "off",
				"noConstAssign": "error"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noDoubleEquals": "off",
				"noVar": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 160
	},
	"files": {
		"includes": [
			"editor/**/*.ts",
			"synth/**/*.ts",
			"player/**/*.ts",
			"shared/**/*.ts",
			"!**/*-lock.json",
			"!!build",
			"!!website",
			"!!archive",
			"!!conventions",
			"!!.kilocode"
		]
	}
}
