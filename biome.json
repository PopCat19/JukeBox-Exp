{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"organizeImports": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": false,
			"correctness": {
				"noUnusedImports": "warn",
				"noUnusedVariables": "off",
				"noConstAssign": "error"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noDoubleEquals": "off"
			},
			"style": {
				"noVar": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 160
	},
	"files": {
		"include": ["editor/**/*.ts", "synth/**/*.ts", "player/**/*.ts", "shared/**/*.ts"],
		"ignore": ["node_modules", "build", "website", "archive", "conventions", ".kilocode", "**/*-lock.json"]
	}
}
