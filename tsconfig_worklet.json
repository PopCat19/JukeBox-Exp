{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"types": [],
		"lib": ["ES2018", "ES2019", "ES2020", "ESNext"],
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"files": [
		"synth/render/worklet.ts",
		"synth/render/worklet-messages.ts"
	],
	"exclude": [
		"node_modules",
		"tests",
		"scripts",
		"tools",
		"website",
		"editor",
		"player",
		"shared"
	]
}
